# Site address: ":80" (plain HTTP on port 80) unless SITE_ADDRESS is set.
# In Step 7.5 SITE_ADDRESS becomes your domain, and Caddy then fetches an
# HTTPS certificate for it automatically.
{$SITE_ADDRESS::80} {
	# Compress responses (the JS bundle shrinks to about a third).
	encode gzip

	# Basic security headers: HTTPS only for a year, no MIME-type guessing,
	# don't send full URLs to other sites, don't reveal the server software.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}


	# API requests go to the api container (Docker's internal name "api").
	handle /api/* {
		reverse_proxy api:8000
	}

	# Everything else: the built React files. Unknown paths fall back to
	# index.html, the standard setup for single-page apps.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# Pipeline Copilot (separate project: github.com/mahendramahato/pipeline-copilot)
# on its own subdomain, with its own HTTPS certificate. Its container joins
# this project's Docker network as "copilot". COPILOT_ADDRESS is the subdomain;
# the default only serves locally.
{$COPILOT_ADDRESS:copilot.localhost} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# One container serves both the React app and the API. Caddy passes
	# Server-Sent Events (the live investigation steps) through unbuffered.
	reverse_proxy copilot:8000
}
